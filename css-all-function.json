  /* =====================================================
   PART 4
   RESTORE / SAVE / FINALIZATION
===================================================== */


/* =====================================================
   RESTORE AFTER PAGE LOAD
===================================================== */

function tryRestore(){

    /*
       لا نستعيد الحالة إلا إذا كانت
       محفوظة فعلًا.
    */

    const restored =
        restoreState();


    if(!restored){

        phase =
            "READY";


        updateStatus();


        return;

    }


    /*
       إذا تم تحميل all-css.json سابقًا
       من نفس الصفحة، يمكن المتابعة.
    */

    if(data){

        setMessage(
            "Previous search restored."
        );

    }
    else{

        setMessage(
            "Previous progress found. " +
            "Load all-css.json to continue."
        );

    }

}


/* =====================================================
   CONTINUE SEARCH
===================================================== */

async function continueSearch(){

    if(running){

        return;

    }


    /*
       يجب أن تكون properties موجودة.
    */

    if(
        properties.length === 0
    ){

        if(
            data
        ){

            initializeData();

        }
        else{

            setMessage(
                "Load all-css.json first."
            );

            return;

        }

    }


    /*
       إذا وصلنا للنهاية فلا يوجد شيء
       آخر لاختباره.
    */

    if(
        propertyIndex >=
        properties.length
    ){

        finishSearch();

        return;

    }


    running =
        true;


    phase =
        "CONTINUING";


    setMessage(
        "Continuing previous search..."
    );


    updateStatus();


    await searchLoop();

}


/* =====================================================
   LOAD JSON WITHOUT FILE INPUT
===================================================== */

async function loadJSONText(
    text
){

    try{

        const parsed =
            JSON.parse(text);


        data =
            parsed;


        initializeData();


        return true;

    }
    catch(error){

        console.error(
            error
        );


        setMessage(
            "JSON ERROR: " +
            error.message
        );


        return false;

    }

}


