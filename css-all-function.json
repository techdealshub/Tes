/* =====================================================
   PERIODIC SAVE
===================================================== */

let periodicSaveTimer =
    null;


function startPeriodicSave(){

    if(
        periodicSaveTimer
    ){

        clearInterval(
            periodicSaveTimer
        );

    }


    periodicSaveTimer =
        setInterval(
            function(){

                if(
                    running
                ){

                    saveState();

                }

            },
            5000
        );

}


/* =====================================================
   STOP PERIODIC SAVE
===================================================== */

function stopPeriodicSave(){

    if(
        periodicSaveTimer
    ){

        clearInterval(
            periodicSaveTimer
        );

        periodicSaveTimer =
            null;

    }

}


/* =====================================================
   PAGE VISIBILITY
===================================================== */

document.addEventListener(
    "visibilitychange",
    function(){

        /*
           عندما يخرج المستخدم من الصفحة
           نحفظ التقدم فورًا.

           هذا مهم جدًا على الهاتف لأن
           Android قد يقتل الصفحة في الخلفية.
        */

        if(
            document.hidden
        ){

            if(
                running ||
                properties.length > 0
            ){

                saveState();

            }

        }

    }
);


/* =====================================================
   PAGE BEFORE UNLOAD
===================================================== */

window.addEventListener(
    "beforeunload",
    function(){

        if(
            running ||
            properties.length > 0
        ){

            saveState();

        }

    }
);


/* =====================================================
   START BUTTON WRAPPER
===================================================== */

async function startSearch(){

    if(running){

        return;

    }


    /*
       إذا كانت لدينا حالة محفوظة
       وتم تحميل الملف، نكمل منها.
    */

    if(
        properties.length > 0 &&
        propertyIndex <
        properties.length
    ){

        await continueSearch();

        return;

    }


    /*
       بحث جديد.
    */

    if(
        !data
    ){

        setMessage(
            "Load all-css.json first."
        );

        return;

    }


    initializeData();


    await start();

}


